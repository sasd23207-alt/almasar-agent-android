{
  "name": "المسار للتجار",
  "short_name": "المسار",
  "description": "إدارة حسابات التجار واستقبال إشعارات واتساب بزنس",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B6E4F",
  "theme_color": "#0B6E4F",
  "icons": [
    { "src": "brand-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [ { "name": "chat", "accept": ["text/plain", ".txt"] } ]
    }
  }
}
